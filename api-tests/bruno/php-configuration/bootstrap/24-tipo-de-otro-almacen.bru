meta {
  name: Tipo de otro almacen
  type: http
  seq: 24
}

post {
  url: {{base_url}}/api/warehouses/{{b_id}}/location-types/{{picking_id}}/hu-policies
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "handling_unit_type_id": "{{box_id}}",
    "accepts_full": true
  }
}

tests {
  test("Tipo de otro almacen", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody()).to.have.all.keys("error");
    expect(res.getBody().error).to.be.a("string").and.not.empty;
    
  });
}
