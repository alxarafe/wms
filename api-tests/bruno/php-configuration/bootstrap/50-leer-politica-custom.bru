meta {
  name: Leer politica custom
  type: http
  seq: 50
}

get {
  url: {{base_url}}/api/warehouses/{{a_id}}/location-types/{{custom_id}}/hu-policies
  body: none
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("Leer politica custom", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal({hu_policies: [bru.getVar("custom_policy_record")]});
  });
}
