meta {
  name: Tipo HU BOX
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/handling-unit-types
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "code": "BOX",
    "name": "Caja",
    "is_active": true
  }
}

tests {
  test("Tipo HU BOX", function () {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody();
    const expected = {
      "code": "BOX",
      "name": "Caja",
      "is_active": true
    };
    expect(data.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);
    expected.id = data.id;
    bru.setVar("box_id", data.id);
    expect(data).to.deep.equal(expected);
    bru.setVar("box_record", data);
  });
}
