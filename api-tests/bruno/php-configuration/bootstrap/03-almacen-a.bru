meta {
  name: Almacen A
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/warehouses
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "code": "A",
    "name": "Principal",
    "aisle_digits": 1,
    "bay_digits": 2,
    "level_digits": 1
  }
}

tests {
  test("Almacen A", function () {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody();
    const expected = {
      "code": "A",
      "name": "Principal",
      "aisle_digits": 1,
      "bay_digits": 2,
      "level_digits": 1,
      "uses_zones": false,
      "separator": ".",
      "include_zone_in_code": false
    };
    expect(data.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);
    expected.id = data.id;
    bru.setVar("a_id", data.id);
    expect(data).to.deep.equal(expected);
    bru.setVar("a_record", data);
  });
}
