meta {
  name: Duplicada politica
  type: http
  seq: 20
}

post {
  url: {{base_url}}/api/warehouses/{{a_id}}/location-types/{{picking_id}}/hu-policies
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "handling_unit_type_id": "{{pallet_id}}",
    "accepts_full": true
  }
}

tests {
  test("Duplicada politica", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody()).to.have.all.keys("error");
    expect(res.getBody().error).to.be.a("string").and.not.empty;
    
  });
}
