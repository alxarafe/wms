meta {
  name: Politica custom crate
  type: http
  seq: 16
}

post {
  url: {{base_url}}/api/warehouses/{{a_id}}/location-types/{{custom_id}}/hu-policies
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "handling_unit_type_id": "{{crate_id}}",
    "accepts_full": true,
    "accepts_partial": true,
    "allows_breakdown": true,
    "allows_full_dispatch": true
  }
}

tests {
  test("Politica custom crate", function () {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody();
    const expected = {
      "location_type_id": bru.getVar("custom_id"),
      "handling_unit_type_id": bru.getVar("crate_id"),
      "accepts_full": true,
      "accepts_partial": true,
      "allows_breakdown": true,
      "allows_full_dispatch": true
    };
    
    expect(data).to.deep.equal(expected);
    bru.setVar("custom_policy_record", data);
  });
}
