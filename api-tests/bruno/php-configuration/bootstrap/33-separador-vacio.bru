meta {
  name: Separador vacio
  type: http
  seq: 33
}

post {
  url: {{base_url}}/api/warehouses
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "code": "BAD",
    "name": "X",
    "aisle_digits": 1,
    "bay_digits": 2,
