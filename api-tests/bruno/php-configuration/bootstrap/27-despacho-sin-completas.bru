meta {
  name: Despacho sin completas
  type: http
  seq: 27
}

post {
  url: {{base_url}}/api/warehouses/{{a_id}}/location-types/{{picking_id}}/hu-policies
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "handling_unit_type_id": "{{box_id}}",
    "accepts_partial": true,
    "allows_full_dispatch": true
  }
}

tests {
  test("Despacho sin completas", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody()).to.have.all.keys("error");
    expect(res.getBody().error).to.be.a("string").and.not.empty;
    
  });
}
