meta {
  name: Formato identico permitido
  type: http
  seq: 58
}

put {
  url: {{base_url}}/api/warehouses/{{a_id}}/format
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "aisle_digits": 2,
    "bay_digits": 2,
    "level_digits": 1,
    "uses_zones": false,
    "separator": ".",
    "include_zone_in_code": false
  }
}

tests {
  test("Formato identico permitido", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.deep.equal(bru.getVar("locked_record"));
  });
}
