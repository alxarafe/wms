meta {
  name: Politica returns box
  type: http
  seq: 15
}

post {
  url: {{base_url}}/api/warehouses/{{a_id}}/location-types/{{returns_id}}/hu-policies
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "handling_unit_type_id": "{{box_id}}",
    "accepts_partial": true
  }
}

tests {
  test("Politica returns box", function () {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody();
    const expected = {
      "location_type_id": bru.getVar("returns_id"),
      "handling_unit_type_id": bru.getVar("box_id"),
      "accepts_full": false,
      "accepts_partial": true,
      "allows_breakdown": false,
      "allows_full_dispatch": false
    };
    
    expect(data).to.deep.equal(expected);
    bru.setVar("returns_policy_record", data);
  });
}
