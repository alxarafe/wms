meta {
  name: Tipo A RETURNS
  type: http
  seq: 10
}

post {
  url: {{base_url}}/api/warehouses/{{a_id}}/location-types
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "code": "RETURNS",
    "name": "Devoluciones",
    "allows_multi_sku": true,
    "allows_multi_batch": true
  }
}

tests {
  test("Tipo A RETURNS", function () {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody();
    const expected = {
      "warehouse_id": bru.getVar("a_id"),
      "code": "RETURNS",
      "name": "Devoluciones",
      "max_locations_per_item": null,
      "allows_multi_sku": true,
      "allows_multi_batch": true
    };
    expect(data.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);
    expected.id = data.id;
    bru.setVar("returns_id", data.id);
    expect(data).to.deep.equal(expected);
    bru.setVar("returns_record", data);
  });
}
