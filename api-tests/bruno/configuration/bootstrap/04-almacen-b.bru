meta {
  name: Almacen B
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/warehouses
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
}

body:json {
  {
    "code": "B",
    "name": "Secundario",
    "aisle_digits": 1,
    "bay_digits": 2,
    "level_digits": 1,
    "uses_zones": true,
    "separator": ".",
    "include_zone_in_code": true
  }
}

tests {
  test("Almacen B", function () {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody();
    const expected = {
      "code": "B",
      "name": "Secundario",
      "aisle_digits": 1,
      "bay_digits": 2,
      "level_digits": 1,
      "uses_zones": true,
      "separator": ".",
      "include_zone_in_code": true
    };
    expect(data.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);
    expected.id = data.id;
    bru.setVar("b_id", data.id);
    expect(data).to.deep.equal(expected);
    bru.setVar("b_record", data);
  });
}
