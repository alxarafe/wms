meta {
  name: CHILLED
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/storage-attributes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "code": "CHILLED",
    "name": "Refrigerado",
    "exclusive_group_code": "THERMAL"
  }
}

tests {
  test("crea el atributo CHILLED", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().code).to.equal("CHILLED");
    expect(res.getBody().name).to.equal("Refrigerado");
  });
}
