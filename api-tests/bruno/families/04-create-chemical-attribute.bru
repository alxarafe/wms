meta {
  name: CHEMICAL
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/storage-attributes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "code": "CHEMICAL",
    "name": "Químico"
  }
}

tests {
  test("crea el atributo CHEMICAL", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().code).to.equal("CHEMICAL");
    expect(res.getBody().name).to.equal("Químico");
  });
}
