meta {
  name: atributo no existente
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/item-families
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "code": "INVALID_FAMILY",
    "name": "Atributo no existente en el catálogo",
    "attributes": [
      "COLD"
    ]
  }
}

tests {
  test("rechaza un atributo que no existe en el catálogo", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.equal("Unknown FAMILY attribute: COLD");
  });
}
