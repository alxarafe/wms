meta {
  name: CHILLED_FOOD
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/item-families
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "code": "CHILLED_FOOD",
    "name": "Alimentos refrigerados",
    "attributes": [
      "CHILLED",
      "FOOD"
    ]
  }
}

tests {
  test("crea CHILLED_FOOD con atributos FOOD y CHILLED", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);
    expect(res.getBody().code).to.equal("CHILLED_FOOD");
    expect(res.getBody().name).to.equal("Alimentos refrigerados");
    expect(res.getBody().attributes).to.eql([
      "CHILLED",
      "FOOD"
    ]);
  });
}
