meta {
  name: JAVA - CHEMICAL
  type: http
  seq: 9
}

post {
  url: {{java_base_url}}/api/item-families
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "code": "CHEMICAL",
    "name": "Productos químicos",
    "attributes": [
      "IS_CHEMICAL"
    ]
  }
}

tests {
  test("crea CHEMICAL con sus atributos", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);
    expect(res.getBody().code).to.equal("CHEMICAL");
    expect(res.getBody().name).to.equal("Productos químicos");
    expect(res.getBody().attributes).to.eql(["IS_CHEMICAL"]);
  });
}
