meta {
  name: listar familias
  type: http
  seq: 9
}

get {
  url: {{base_url}}/api/item-families
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("lista las cinco familias creadas en orden de código", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.be.an("array");
    expect(body.length).to.equal(5);
    expect(body.map((f) => f.code)).to.eql([
      "CHEMICAL",
      "CHILLED_FOOD",
      "DRY_FOOD",
      "FROZEN_FOOD",
      "NEUTRAL"
    ]);
    body.forEach((f) => {
      expect(f.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);
      expect(f.name).to.be.a("string");
      expect(f.attributes).to.be.an("array");
    });
  });
}
