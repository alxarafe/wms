meta {
  name: JAVA - REFRIGERATED_FOOD
  type: http
  seq: 6
}

post {
  url: {{java_base_url}}/api/item-families
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "code": "REFRIGERATED_FOOD",
    "name": "Alimentos refrigerados",
    "attributes": [
      "IS_FOOD",
      "IS_REFRIGERATED"
    ]
  }
}

tests {
  test("crea REFRIGERATED_FOOD con sus atributos", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);
    expect(res.getBody().code).to.equal("REFRIGERATED_FOOD");
    expect(res.getBody().name).to.equal("Alimentos refrigerados");
    expect(res.getBody().attributes).to.eql(["IS_FOOD", "IS_REFRIGERATED"]);
  });
}
