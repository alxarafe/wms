tests {
  test("crea CAJA24 sin lote", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().sku).to.equal("CAJA24");
    expect(res.getBody().name).to.equal("Caja de 24 latas");
    expect(res.getBody().familyCode).to.equal("FOOD");
    expect(res.getBody().baseUomCode).to.equal("PAL");
    expect(res.getBody().isBatchManaged).to.equal(false);
    expect(res.getBody().isExpirable).to.equal(false);
  });
}