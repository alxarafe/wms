meta {
  name: crear atributo FOOD
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/storage-attributes
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "code": "FOOD",
    "name": "Alimento"
  }
}

tests {
  test("crea el atributo FOOD", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);
    expect(res.getBody().code).to.equal("FOOD");
    expect(res.getBody().name).to.equal("Alimento");
  });
}
