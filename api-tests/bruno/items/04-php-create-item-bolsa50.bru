meta {
  name: PHP - crear BOLSA50
  type: http
  seq: 4
}

post {
  url: {{php_base_url}}/api/items
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "sku": "BOLSA50",
    "name": "Bolsa de 50 kg",
    "familyCode": "FOOD",
    "baseUomCode": "BOX",
    "isBatchManaged": true,
    "isExpirable": true
  }
}

tests {
  test("crea BOLSA50 con familia, unidad y flags", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);
    expect(res.getBody().sku).to.equal("BOLSA50");
    expect(res.getBody().name).to.equal("Bolsa de 50 kg");
    expect(res.getBody().familyCode).to.equal("FOOD");
    expect(res.getBody().baseUomCode).to.equal("BOX");
    expect(res.getBody().isBatchManaged).to.equal(true);
    expect(res.getBody().isExpirable).to.equal(true);
  });
}