meta {
  name: sku demasiado largo
  type: http
  seq: 13
}

post {
  url: {{base_url}}/api/items
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "sku": "SKU-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX",
    "name": "Artículo con SKU inválido",
    "familyCode": "CHILLED_FOOD",
    "baseUomCode": "BOX",
    "isBatchManaged": false,
    "isExpirable": false
  }
}

tests {
  test("rechaza un SKU que supera la longitud permitida", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.contain("SKU must not exceed 50 characters");
  });
}
