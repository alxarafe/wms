meta {
  name: crear uom PAL
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/uoms
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "code": "PAL",
    "description": "Standard Pallet"
  }
}

tests {
  test("crea la unidad PAL para los artículos", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().code).to.equal("PAL");
    expect(res.getBody().description).to.equal("Standard Pallet");
  });
}
