meta {
  name: listar artículos
  type: http
  seq: 6
}

get {
  url: {{base_url}}/api/items
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("lista los artículos en orden de sku", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.be.an("array");
    expect(body.length).to.equal(2);
    expect(body.map((i) => i.sku)).to.eql(["BOLSA50", "CAJA24"]);
    expect(body[0]).to.eql({
      id: body[0].id,
      sku: "BOLSA50",
      name: "Bolsa de 50 kg",
      familyCode: "FOOD",
      baseUomCode: "BOX",
      isBatchManaged: true,
      isExpirable: true
    });
    expect(body[1]).to.eql({
      id: body[1].id,
      sku: "CAJA24",
      name: "Caja de 24 latas",
      familyCode: "FOOD",
      baseUomCode: "PAL",
      isBatchManaged: false,
      isExpirable: false
    });
    body.forEach((i) => {
      expect(i.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);
    });
  });
}
