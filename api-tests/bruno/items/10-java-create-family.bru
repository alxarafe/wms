meta {
  name: JAVA - crear familia FOOD
  type: http
  seq: 10
}

post {
  url: {{java_base_url}}/api/item-families
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "code": "FOOD",
    "name": "Alimentos",
    "attributes": []
  }
}

tests {
  test("crea la familia FOOD", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().code).to.equal("FOOD");
    expect(res.getBody().attributes).to.eql([]);
  });
}