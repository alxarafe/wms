meta {
  name: Java - entrada REFRI con lote
  type: http
  seq: 14
}

post {
  url: {{java_base_url}}/api/receipts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "locationId": "01a0aca9-bc00-7020-8000-000000000008",
    "itemCode": "REFRI",
    "quantity": 30,
    "unit": "EA",
    "batchCode": "L-REF-001"
  }
}

tests {
  test("Java recibe REFRI con lote y ocupa P-A-04-02", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().code).to.equal("P-A-04-02");
    expect(res.getBody().references[0].itemCode).to.equal("REFRI");
    expect(res.getBody().references[0].batchCode).to.equal("L-REF-001");
    expect(res.getBody().references[0].quantity).to.equal(30);
  });
}