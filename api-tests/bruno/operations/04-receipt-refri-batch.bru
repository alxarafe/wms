meta {
  name: entrada YOGUR FRESA con lote
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/receipts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "locationId": "01a0aca9-bc00-7020-8000-000000000008",
    "itemCode": "YOGUR FRESA",
    "quantity": 30,
    "unit": "EA",
    "batchCode": "L-YOG-001"
  }
}

tests {
  test("recibe YOGUR FRESA con lote y ocupa P-A-04-02", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().code).to.equal("P-A-04-02");
    expect(res.getBody().references[0].itemCode).to.equal("YOGUR FRESA");
    expect(res.getBody().references[0].batchCode).to.equal("L-YOG-001");
    expect(res.getBody().references[0].quantity).to.equal(30);
  });
}
