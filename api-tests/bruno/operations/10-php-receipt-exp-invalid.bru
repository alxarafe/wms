meta {
  name: PHP - caducidad con formato inválido
  type: http
  seq: 10
}

post {
  url: {{php_base_url}}/api/receipts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "locationId": "01a0aca9-bc00-7020-8000-000000000004",
    "itemCode": "PALITOS CANGREJO",
    "quantity": 20,
    "unit": "EA",
    "batchCode": "L-PAL-001",
    "expirationDate": "15/03/2027"
  }
}

tests {
  test("PHP valida el formato ISO-8601 de la caducidad", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error).to.include("Expiration date must be an ISO-8601 date or datetime.");
  });
}