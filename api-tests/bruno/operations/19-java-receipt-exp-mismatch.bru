meta {
  name: Java - caducidad distinta del lote
  type: http
  seq: 19
}

post {
  url: {{java_base_url}}/api/receipts
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "locationId": "01a0aca9-bc00-7020-8000-000000000004",
    "itemCode": "YOGUR FRESA",
    "quantity": 30,
    "unit": "EA",
    "batchCode": "L-YOG-001",
    "expirationDate": "2027-03-15T00:00:00Z"
  }
}

tests {
  test("Java rechaza una caducidad distinta de la almacenada para L-YOG-001", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().error).to.include("does not match the stored expiration of batch L-YOG-001");
  });
}