meta {
  name: crear EA
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/uoms
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "code": "EA",
    "description": "Unit / Each"
  }
}

tests {
  test("crea EA con su descripción", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);
    expect(res.getBody().code).to.equal("EA");
    expect(res.getBody().description).to.equal("Unit / Each");
  });
}
