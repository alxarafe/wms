meta {
  name: PHP - listar uoms
  type: http
  seq: 8
}

get {
  url: {{php_base_url}}/api/uoms
  auth: none
}

headers {
  Accept: application/json
}

tests {
  test("lista las siete unidades en orden de código", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body).to.be.an("array");
    expect(body.length).to.equal(7);
    expect(body.map((u) => u.code)).to.eql([
      "BAG",
      "BOX",
      "EA",
      "KG",
      "LTR",
      "PAL",
      "PZA"
    ]);
    body.forEach((u) => {
      expect(u.id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);
      expect(u.description).to.be.a("string");
    });
  });
}