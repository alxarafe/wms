meta {
  name: PHP - crear PZA
  type: http
  seq: 3
}

post {
  url: {{php_base_url}}/api/uoms
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "code": "PZA",
    "description": "Unidad suelta"
  }
}

tests {
  test("crea PZA con su descripción", function () {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().id).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i);
    expect(res.getBody().code).to.equal("PZA");
    expect(res.getBody().description).to.equal("Unidad suelta");
  });
}