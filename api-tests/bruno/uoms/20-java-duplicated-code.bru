meta {
  name: JAVA - código duplicado EA
  type: http
  seq: 20
}

post {
  url: {{java_base_url}}/api/uoms
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "code": "EA",
    "description": "Unit / Each"
  }
}

tests {
  test("rechaza una unidad ya existente", function () {
    expect(res.getStatus()).to.equal(409);
    expect(res.getBody().error).to.equal("Uom code already exists.");
  });
}