<?xml version="1.0"?>
<ruleset name="Hexagonal">

    <!-- Analize only the PHP files -->
    <arg name="extensions" value="php"/>

    <!-- Do not fail on warnings -->
    <arg name="warning-severity" value="0"/>

    <!-- Normalize paths -->
    <arg name="basepath" value="."/>

    <!-- Paths to analyze -->
    <file>src</file>
    <file>tests</file>

    <!-- Standards -->
    <rule ref="PSR12"/>

</ruleset>
